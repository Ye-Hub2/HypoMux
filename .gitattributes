* text=auto

*.go text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf

# The portable launchers and readme are checked out with CRLF: the .cmd scripts
# are CRLF sensitive and the Windows runners do not guarantee core.autocrlf.
*.cmd text eol=crlf
desktop/portable/*.txt text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.dll binary
*.exe binary
